generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  passwordHash       String
  name               String?
  role               Role      @default(ADMIN)
  status             String    @default("ACTIVE")
  emailVerified      Boolean   @default(false)
  verifyCode         String?
  verifyCodeExpires  DateTime?
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
}

enum ClassType {
  THEORY
  LAB
}

model Course {
  id       Int       @id @default(autoincrement())
  code     String    @unique
  title    String
  type     ClassType @default(THEORY)
  sessions Session[]
  // Back-relation only (Step 49) — adds no column to this table.
  exams    Exam[]
}

model Teacher {
  id       Int       @id @default(autoincrement())
  initials String    @unique
  name     String
  userId   Int?      @unique
  sessions Session[]
}

model Room {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  capacity  Int        @default(40)
  sessions  Session[]
  // Back-relation only (Step 49) — adds no column to this table.
  examRooms ExamRoom[]
}

model Batch {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  semester     String
  studentCount Int       @default(0)
  // 1 = no sections (the whole batch is one group); 2 = split into "Sec 1"
  // and "Sec 2". Drives every "does this batch have sections?" decision —
  // the section dropdown, the grid's two section rows, Combine eligibility
  // and the API's section validation — so those no longer have to be
  // inferred from whichever sessions a version happens to contain (Step 50).
  sectionCount Int       @default(1)
  sessions     Session[]
  // Back-relation only (Step 49) — adds no column to this table.
  exams        Exam[]
}

model TimeSlot {
  id        Int       @id @default(autoincrement())
  label     String
  sortOrder Int
  sessions  Session[]
}

model Session {
  id         Int             @id @default(autoincrement())
  day        String
  timeSlot   TimeSlot        @relation(fields: [timeSlotId], references: [id])
  timeSlotId Int
  batch      Batch           @relation(fields: [batchId], references: [id])
  batchId    Int
  section    String?
  course     Course          @relation(fields: [courseId], references: [id])
  courseId   Int
  teacher    Teacher         @relation(fields: [teacherId], references: [id])
  teacherId  Int
  room       Room            @relation(fields: [roomId], references: [id])
  roomId     Int
  version    RoutineVersion? @relation(fields: [versionId], references: [id])
  versionId  Int?
  status     String          @default("ACTIVE")
  createdAt  DateTime        @default(now())
}

model Notice {
  id         Int      @id @default(autoincrement())
  title      String
  body       String   @db.Text
  audience   String   @default("ALL")
  postedById Int?
  createdAt  DateTime @default(now())
}

model RoutineVersion {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  isPublished   Boolean   @default(false)
  effectiveDate DateTime?
  createdAt     DateTime  @default(now())
  sessions      Session[]
}

model Student {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  batchId   Int
  studentId String?
  createdAt DateTime @default(now())
}

model Alarm {
  id          Int      @id @default(autoincrement())
  studentId   Int
  sessionId   Int
  leadMinutes Int      @default(15)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([studentId, sessionId])
}

model Reschedule {
  id            Int       @id @default(autoincrement())
  sessionId     Int
  changedById   Int?
  oldDay        String
  oldTimeSlotId Int
  oldRoomId     Int
  newDay        String
  newTimeSlotId Int
  newRoomId     Int
  reason        String?   @db.Text
  status        String    @default("PENDING")
  reviewedById  Int?
  reviewedAt    DateTime?
  adminNote     String?   @db.Text
  appliedToMaster Boolean @default(false)
  originalDate  DateTime?
  newDate       DateTime?
  createdAt     DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Exam routine (Step 49) — a separate schedule from the weekly class routine.
// Deliberately its own tables: exams are free-form (any date including
// Thu/Sat, arbitrary start/end times, several rooms per exam) and so don't
// fit Session's day + fixed-TimeSlot shape. Lab vs theory is never stored
// here; it is read from Course.type.
// ---------------------------------------------------------------------------

enum ExamType {
  MIDTERM
  FINAL
}

/// One semester's exam schedule, holding both its Midterm and Final exams.
model ExamTerm {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  /// Only published terms will be visible to teachers/students (Step 51).
  isPublished Boolean  @default(false)
  /// Optional note printed under the routine.
  note        String?  @db.Text
  createdAt   DateTime @default(now())
  exams       Exam[]
}

model Exam {
  id        Int        @id @default(autoincrement())
  termId    Int
  term      ExamTerm   @relation(fields: [termId], references: [id], onDelete: Cascade)
  type      ExamType
  courseId  Int
  course    Course     @relation(fields: [courseId], references: [id])
  batchId   Int
  batch     Batch      @relation(fields: [batchId], references: [id])
  /// "Sec 1" | "Sec 2" | "Both" | null — the same values and rules as
  /// Session.section, validated with isValidSectionFor against the batch.
  section   String?
  date      DateTime   @db.Date
  /// "HH:MM", 24-hour. Free-form rather than a TimeSlot: exam lengths vary
  /// (1h30 midterm theory, 2h final theory, 2h labs).
  startTime String
  endTime   String
  createdAt DateTime   @default(now())
  rooms     ExamRoom[]

  @@index([date])
}

/// An exam can occupy several rooms at once (e.g. 228, 251, 103).
model ExamRoom {
  id     Int  @id @default(autoincrement())
  examId Int
  exam   Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  roomId Int
  room   Room @relation(fields: [roomId], references: [id])

  @@unique([examId, roomId])
}
